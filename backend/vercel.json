{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/demo",
      "destination": "/product.html"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "content/**"
    }
  },
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/app",
      "destination": "/product",
      "permanent": false
    }
  ]
}
