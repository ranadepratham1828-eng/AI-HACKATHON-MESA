# Copy this file to .env and fill in your key. Never commit .env.

# Port the API listens on
PORT=4747

# Which AI to use: gemini | openai-compatible | none
# "none" (or no key at all) runs on scripted demo answers, so the demo still works offline.
AI_PROVIDER=gemini

# --- Google Gemini (free tier, recommended) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "gemini-flash-latest" always points at Google's current Flash model.
# Run `npm run models` to see every model your key can use.
GEMINI_MODEL=gemini-flash-latest
# Tried automatically if the main model is rate-limited or unavailable.
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# --- Any OpenAI-compatible API (e.g. Groq or OpenRouter free models), optional backup ---
# Groq:       OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# OpenRouter: OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
# Pick a model from your provider's model list. Use a vision model if you want photo feedback.
OPENAI_COMPAT_MODEL=

# Seconds to wait for the AI before falling back to a scripted answer
AI_TIMEOUT_SECONDS=45

# Where student data is saved (JSON file, created automatically)
DATA_FILE=data/db.json

# Which website may call this API. "*" allows any (fine for the demo).
CORS_ORIGIN=*

# --- Accounts (paid model: no public sign-up) ---
# Secret key for the admin page at /app#admin, where the Dishaa team creates accounts.
# Use a long random value and never share it.
ADMIN_KEY=

# --- Email (login details are emailed via Resend: https://resend.com) ---
# Without these, the admin page shows each new password so you can send it yourself.
RESEND_API_KEY=
# A sender on a domain you've verified in Resend, e.g. "Dishaa <hello@yourdomain.com>"
EMAIL_FROM=
# The public address of the site, used in the login link inside emails
APP_URL=https://ai-hackathon-mesa-backend.vercel.app
# Optional: get an email for every "Request a demo" form on the landing page
LEADS_NOTIFY_EMAIL=
